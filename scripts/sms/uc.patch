+void UnderlyingCliqueChecker::checkProperty(const adjacency_matrix_t &m)
+{
+    int n = (int)m.size();
+    vector<unsigned long long> adj(n, 0);
+    for (int i = 0; i < n; i++)
+        for (int j = i + 1; j < n; j++)
+            if (m[j][i] == truth_value_true)
+                adj[i] |= 1ULL << j, adj[j] |= 1ULL << i;
+    auto clauseOf = [&](const vector<pair<int, int>> &es) {
+        forbidden_graph_t fg;
+        for (auto e : es)
+            fg.push_back(make_pair(truth_value_true, make_pair(max(e.first, e.second), min(e.first, e.second))));
+        throw fg;
+    };
+    vector<int> cur, out;
+    unsigned long long all = (n == 64) ? ~0ULL : ((1ULL << n) - 1);
+    if (ucFind(adj, cur, all, k + 1, out))
+    {
+        vector<pair<int, int>> es;
+        for (int a = 0; a < (int)out.size(); a++)
+            for (int b = a + 1; b < (int)out.size(); b++)
+                es.push_back({out[a], out[b]});
+        clauseOf(es);
+    }
+    if (k < 8) return;
+    // K7 with three common neighbours: enumerate 7-cliques
+    vector<int> c7;
+    std::function<bool(unsigned long long)> rec = [&](unsigned long long cand) -> bool {
+        if ((int)c7.size() == 7)
+        {
+            unsigned long long common = all;
+            for (int v : c7) common &= adj[v];
+            if (__builtin_popcountll(common) >= 3)
+            {
+                vector<int> w;
+                for (int t = 0; t < 3; t++) { int x = __builtin_ctzll(common); common &= common - 1; w.push_back(x); }
+                vector<pair<int, int>> es;
+                for (int a = 0; a < 7; a++)
+                    for (int b = a + 1; b < 7; b++) es.push_back({c7[a], c7[b]});
+                for (int x : w)
+                    for (int a = 0; a < 7; a++) es.push_back({x, c7[a]});
+                clauseOf(es);
+            }
+            return false;
+        }
+        if ((int)c7.size() + __builtin_popcountll(cand) < 7) return false;
+        while (cand)
+        {
+            int v = __builtin_ctzll(cand);
+            cand &= cand - 1;
+            c7.push_back(v);
+            rec(cand & adj[v]);
+            c7.pop_back();
+            if ((int)c7.size() + __builtin_popcountll(cand) < 7) return false;
+        }
+        return false;
+    };
+    rec(all);
+    if (k < 11) return;
+    // 11-vertex obstructions: an 8-clique Q plus 3 vertices whose non-edges inside S = Q + 3 form a subgraph of 3K2 or of a bowtie
+    vector<int> q8;
+    std::function<void(unsigned long long)> rec8 = [&](unsigned long long cand) {
+        if ((int)q8.size() == 8)
+        {
+            unsigned long long qm = 0;
+            for (int v : q8) qm |= 1ULL << v;
+            vector<int> W;
+            for (int v = 0; v < n; v++)
+                if (!((qm >> v) & 1) && __builtin_popcountll(adj[v] & qm) >= 6) W.push_back(v);
+            for (int a = 0; a < (int)W.size(); a++)
+                for (int b = a + 1; b < (int)W.size(); b++)
+                    for (int c = b + 1; c < (int)W.size(); c++)
+                    {
+                        vector<int> S = q8;
+                        S.push_back(W[a]); S.push_back(W[b]); S.push_back(W[c]);
+                        int s = 11;
+                        vector<vector<int>> C(s);
+                        int ne = 0;
+                        for (int x = 0; x < s; x++)
+                            for (int y = x + 1; y < s; y++)
+                                if (!((adj[S[x]] >> S[y]) & 1)) { C[x].push_back(y); C[y].push_back(x); ne++; }
+                        bool bad = false;
+                        // subgraph of 3K2: max degree <= 1 and at most 3 edges
+                        int md = 0;
+                        for (int x = 0; x < s; x++) md = std::max(md, (int)C[x].size());
+                        if (md <= 1 && ne <= 3) bad = true;
+                        // subgraph of P3 + 2K2 (K11 - (P3 + 2K2) is not biplanar): one degree-2 vertex whose neighbours have degree 1
+                        if (!bad && md == 2 && ne <= 4)
+                        {
+                            int d2 = 0, cen = -1;
+                            for (int x = 0; x < s; x++) if ((int)C[x].size() == 2) { d2++; cen = x; }
+                            if (d2 == 1 && C[C[cen][0]].size() == 1 && C[C[cen][1]].size() == 1) bad = true;
+                        }
+                        // subgraph of a bowtie: some centre c with C - c a matching of <= 2 edges and |V(M) u N(c)| <= 4
+                        for (int cc = 0; cc < s && !bad; cc++)
+                        {
+                            int me = 0; bool ok = true; unsigned int vm = 0;
+                            for (int x = 0; x < s && ok; x++)
+                            {
+                                if (x == cc) continue;
+                                int d = 0;
+                                for (int y : C[x]) if (y != cc) { d++; vm |= 1u << x; if (x < y) me++; }
+                                if (d > 1) ok = false;
+                            }
+                            if (!ok || me > 2) continue;
+                            for (int y : C[cc]) vm |= 1u << y;
+                            if (__builtin_popcount(vm) <= 4) bad = true;
+                        }
+                        if (bad)
+                        {
+                            vector<pair<int, int>> es;
+                            for (int x = 0; x < s; x++)
+                                for (int y = x + 1; y < s; y++)
+                                    if ((adj[S[x]] >> S[y]) & 1) es.push_back({S[x], S[y]});
+                            clauseOf(es);
+                        }
+                    }
+            return;
+        }
+        if ((int)q8.size() + __builtin_popcountll(cand) < 8) return;
+        while (cand)
+        {
+            int v = __builtin_ctzll(cand);
+            cand &= cand - 1;
+            q8.push_back(v);
+            rec8(cand & adj[v]);
+            q8.pop_back();
+            if ((int)q8.size() + __builtin_popcountll(cand) < 8) return;
+        }
+    };
+    rec8(all);
+    // K11 minus two disjoint triangles: a 7-clique Q plus 4 vertices whose non-edges inside S = Q + 4 form at most two
+    // components, each with at most 3 vertices
+    vector<int> q7;
+    std::function<void(unsigned long long)> rec7 = [&](unsigned long long cand) {
+        if ((int)q7.size() == 7)
+        {
+            unsigned long long qm = 0;
+            for (int v : q7) qm |= 1ULL << v;
+            vector<int> W;
+            for (int v = 0; v < n; v++)
+                if (!((qm >> v) & 1) && __builtin_popcountll(adj[v] & qm) >= 6) W.push_back(v);
+            int w = (int)W.size();
+            for (int a = 0; a < w; a++) for (int b = a + 1; b < w; b++) for (int c = b + 1; c < w; c++) for (int d = c + 1; d < w; d++)
+            {
+                vector<int> S = q7;
+                S.push_back(W[a]); S.push_back(W[b]); S.push_back(W[c]); S.push_back(W[d]);
+                int s = 11; vector<int> comp(s, -1); vector<vector<int>> C(s);
+                for (int x = 0; x < s; x++)
+                    for (int y = x + 1; y < s; y++)
+                        if (!((adj[S[x]] >> S[y]) & 1)) { C[x].push_back(y); C[y].push_back(x); }
+                int nontriv = 0; bool ok = true;
+                for (int x = 0; x < s && ok; x++)
+                {
+                    if (comp[x] >= 0 || C[x].empty()) continue;
+                    vector<int> st = {x}; comp[x] = x; int sz = 0;
+                    while (!st.empty()) { int u = st.back(); st.pop_back(); sz++; for (int y : C[u]) if (comp[y] < 0) { comp[y] = x; st.push_back(y); } }
+                    nontriv++;
+                    if (sz > 3) ok = false;
+                }
+                if (ok && nontriv <= 2)
+                {
+                    vector<pair<int, int>> es;
+                    for (int x = 0; x < s; x++)
+                        for (int y = x + 1; y < s; y++)
+                            if ((adj[S[x]] >> S[y]) & 1) es.push_back({S[x], S[y]});
+                    clauseOf(es);
+                }
+            }
+            return;
+        }
+        if ((int)q7.size() + __builtin_popcountll(cand) < 7) return;
+        while (cand)
+        {
+            int v = __builtin_ctzll(cand);
+            cand &= cand - 1;
+            q7.push_back(v);
+            rec7(cand & adj[v]);
+            q7.pop_back();
+            if ((int)q7.size() + __builtin_popcountll(cand) < 7) return;
+        }
+    };
+    rec7(all);
+}
