+/** Directed thickness-two layout: the underlying edge {i<j} is present iff the lower arc m[j][i] is true.
+ Forbids K_{k+1} (k = maxClique) and, if k >= 8, K10 minus a triangle (a K7 with three common neighbours). */
+class UnderlyingCliqueChecker : public PartiallyDefinedGraphChecker
+{
+    int k;
+public:
+    UnderlyingCliqueChecker(int frequency, int k)
+    {
+        this->name = "UnderlyingCliqueChecker";
+        this->frequency = frequency;
+        this->k = k;
+    }
+    void checkProperty(const adjacency_matrix_t &matrix);
+};
