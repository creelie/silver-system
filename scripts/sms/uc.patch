+static bool ucFind(const vector<unsigned long long> &adj, vector<int> &cur, unsigned long long cand, int need, vector<int> &out)
+{
+    if ((int)cur.size() == need) { out = cur; return true; }
+    if ((int)cur.size() + __builtin_popcountll(cand) < need) return false;
+    while (cand)
+    {
+        int v = __builtin_ctzll(cand);
+        cand &= cand - 1;
+        cur.push_back(v);
+        if (ucFind(adj, cur, cand & adj[v], need, out)) return true;
+        cur.pop_back();
+        if ((int)cur.size() + __builtin_popcountll(cand) < need) return false;
+    }
+    return false;
+}
